# Paste into the Environment tab of the Dokploy compose service, then replace every value.
# Generate each secret separately, for example with: openssl rand -hex 32
# The full list of optional settings is in the repository's .env.example.

# Public hostname only, no scheme. Must match the domain set on the `web` service.
RAKAZO_HOST=rakazo.example.com

# URL-safe value: it is placed inside the database URL.
POSTGRES_PASSWORD=replace-with-openssl-rand-hex-16

BETTER_AUTH_SECRET=replace-with-openssl-rand-hex-32
# Exactly 64 hex characters.
ENCRYPTION_KEY=replace-with-openssl-rand-hex-32
SCREEN_PROXY_SECRET=replace-with-openssl-rand-hex-32
SANDBOX_SUPERVISOR_TOKEN=replace-with-openssl-rand-hex-32

# Only these emails can create an account. The first account becomes the owner.
SIGNUPS_ENABLED=true
SIGNUP_ALLOWLIST=you@example.com

# Optional deployment-wide default model. Users can also connect a model after signing in.
# ANTHROPIC_API_KEY=
# PI_DEFAULT_PROVIDER=anthropic
# PI_DEFAULT_MODEL=claude-haiku-5-5

# Bot computer limits (each running computer is one container).
RAKAZO_COMPUTER_MEMORY=2g
RAKAZO_COMPUTER_CPUS=2
